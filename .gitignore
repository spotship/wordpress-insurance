# Ship pipeline artifacts — local only
.ship/

# Dependencies
vendor/
node_modules/

# Build output
dist/
*.zip

# Local env
.env
.DS_Store

# Written by bin/mutation-check.js; transient reports, never committed.
#
# MATCHED BY SHAPE, like the phpunit caches below. There was one report file
# when this line named one, and a second suite arrived without this line being
# touched -- which is how the third one ships.
mutation-junit.xml
mutation-check-*.txt

# PHPUnit writes these next to the config it was given; local runs only.
.phpunit.result.cache
.phpunit-integration.result.cache

# bin/set-version.sh writes <file>.set-version.tmp beside each file it
# rewrites, and moves it into place — same filesystem, so the rename is atomic
# and a half-written plugin header never exists. Its EXIT trap clears the tmp,
# but a trap does not run on SIGKILL or a cancelled runner, and a stray one left
# at the repo root then fails bin/build-dist.sh's ship-list check on the next
# build, naming a file nobody wrote on purpose.
*.set-version.tmp

# Written by the semantic-release prepareCmd so bin/set-version.sh can read
# ${nextRelease.notes} without it passing through the shell. Consumed and
# deleted by that script; never committed, never shipped.
.sswi-release-notes.md
