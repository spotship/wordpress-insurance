{
  "name": "spotship-wordpress-insurance",
  "version": "0.0.0-development",
  "private": true,
  "description": "Tooling only. This repo ships PHP; package.json exists for semantic-release, wp-env and the jsdom suite \u2014 same as every other repo in the org.",
  "scripts": {
