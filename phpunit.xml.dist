<?xml version="1.0"?>
<phpunit
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
	colors="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	failOnWarning="true"
	failOnRisky="true"
	cacheResultFile=".phpunit.result.cache"
	bootstrap="tests/bootstrap-unit.php">

	<testsuites>
		<!--
		  `unit` runs with Brain Monkey and NO WordPress bootstrap, so it is fast
		  and runs anywhere a PHP binary exists. The risk in this plugin is
		  concentrated in pure functions (trimmers, HMAC, cache tiering, payload
		  mapping), which is what makes that split worth having.
		-->
		<testsuite name="unit">
			<directory suffix="Test.php">tests/unit</directory>
		</testsuite>

		<!--
		  `integration` needs a real WordPress bootstrap and therefore wp-env.
		  Run it with:
		    npx wp-env run tests-cli --env-cwd=wp-content/plugins/<slug> \
		      vendor/bin/phpunit --testsuite integration
		-->
		<testsuite name="integration">
			<directory suffix="Test.php">tests/integration</directory>
		</testsuite>
	</testsuites>
</phpunit>
